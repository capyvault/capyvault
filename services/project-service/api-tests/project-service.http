### =========================================================
### CapyVault Project Service API Tests
### Base URL: http://localhost:8082
### =========================================================

@projectBaseUrl = http://localhost:8082
@actorUuid = 0f878263-11fa-4408-a729-2c584a871e09


### ---------------------------------------------------------
### 1. Health check
### ---------------------------------------------------------
GET {{projectBaseUrl}}/actuator/health
Accept: application/json


### ---------------------------------------------------------
### 2. Create project
### ---------------------------------------------------------
POST {{projectBaseUrl}}/api/v1/projects
Content-Type: application/json
Accept: application/json

{
  "name": "Payment API",
  "slug": "payment-api",
  "description": "Project for payment microservice secrets and config",
  "actorUuid": "{{actorUuid}}"
}

> {%
    client.test("Create project - status is 201 or 200", function () {
        client.assert(response.status === 201 || response.status === 200, "Expected 201 or 200");
    });

    client.global.set("projectUuid", response.body.data.uuid);

    client.log("Created project UUID: " + response.body.data.uuid);
%}


### ---------------------------------------------------------
### 3. Get all projects
### ---------------------------------------------------------
GET {{projectBaseUrl}}/api/v1/projects
Accept: application/json

> {%
    client.test("Get all projects - success", function () {
        client.assert(response.status === 200, "Expected 200");
    });
%}


### ---------------------------------------------------------
### 4. Get project by UUID
### ---------------------------------------------------------
GET {{projectBaseUrl}}/api/v1/projects/{{projectUuid}}
Accept: application/json

> {%
    client.test("Get project by UUID - success", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.data.uuid === client.global.get("projectUuid"), "Project UUID should match");
    });
%}


### ---------------------------------------------------------
### 5. Update project
### ---------------------------------------------------------
PUT {{projectBaseUrl}}/api/v1/projects/{{projectUuid}}
Content-Type: application/json
Accept: application/json

{
  "name": "Payment API Updated",
  "slug": "payment-api",
  "description": "Updated payment project description"
}

> {%
    client.test("Update project - success", function () {
        client.assert(response.status === 200, "Expected 200");
    });
%}


### ---------------------------------------------------------
### 6. Create DEV environment
### ---------------------------------------------------------
POST {{projectBaseUrl}}/api/v1/projects/{{projectUuid}}/environments
Content-Type: application/json
Accept: application/json

{
  "name": "Development",
  "slug": "dev",
  "description": "Development environment",
  "actorUuid": "{{actorUuid}}"
}

> {%
    client.test("Create DEV environment - success", function () {
        client.assert(response.status === 201 || response.status === 200, "Expected 201 or 200");
    });

    client.global.set("devEnvironmentUuid", response.body.data.uuid);

    client.log("Created DEV environment UUID: " + response.body.data.uuid);
%}


