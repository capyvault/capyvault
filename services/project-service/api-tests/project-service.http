%}


### ---------------------------------------------------------
### 8. Get project environments
### ---------------------------------------------------------
GET {{projectBaseUrl}}/api/v1/projects/{{projectUuid}}/environments
Accept: application/json

> {%
    client.test("Get project environments - success", function () {
        client.assert(response.status === 200, "Expected 200");
    });
%}


### ---------------------------------------------------------
### 9. Get one environment
### ---------------------------------------------------------
GET {{projectBaseUrl}}/api/v1/projects/{{projectUuid}}/environments/{{devEnvironmentUuid}}
Accept: application/json

> {%
    client.test("Get environment - success", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.data.uuid === client.global.get("devEnvironmentUuid"), "Environment UUID should match");
    });
%}


### ---------------------------------------------------------
### 10. Update environment
### ---------------------------------------------------------
PUT {{projectBaseUrl}}/api/v1/projects/{{projectUuid}}/environments/{{devEnvironmentUuid}}
Content-Type: application/json
Accept: application/json

{
  "name": "Development Updated",
  "slug": "dev",
  "description": "Updated development environment"
}

> {%
    client.test("Update environment - success", function () {
        client.assert(response.status === 200, "Expected 200");
    });
%}


### ---------------------------------------------------------
### 11. Internal validation API
### This is used by secret-service.
### ---------------------------------------------------------
GET {{projectBaseUrl}}/internal/v1/projects/{{projectUuid}}/environments/{{prodEnvironmentUuid}}
Accept: application/json

> {%
    client.test("Internal project environment validation - success", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.data.available === true, "Project environment should be available");
    });
%}


### ---------------------------------------------------------
### 12. Duplicate project slug test
### Expected: 409 Conflict or 400 Bad Request depending on your handler
### ---------------------------------------------------------
POST {{projectBaseUrl}}/api/v1/projects
Content-Type: application/json
Accept: application/json

{
  "name": "Payment API Duplicate",
  "slug": "payment-api",
  "description": "Duplicate slug test",
  "actorUuid": "{{actorUuid}}"
}

> {%
    client.test("Duplicate project slug should fail", function () {
        client.assert(
            response.status === 409 || response.status === 400,
            "Expected 409 or 400"
        );
    });
%}


### ---------------------------------------------------------
### 13. Duplicate environment slug test
### Expected: 409 Conflict or 400 Bad Request
### ---------------------------------------------------------
POST {{projectBaseUrl}}/api/v1/projects/{{projectUuid}}/environments
Content-Type: application/json
Accept: application/json

{
  "name": "Duplicate Production",
  "slug": "prod",
  "description": "Duplicate environment slug test",
  "actorUuid": "{{actorUuid}}"
}

> {%
    client.test("Duplicate environment slug should fail", function () {
        client.assert(
            response.status === 409 || response.status === 400,
            "Expected 409 or 400"
        );
    });
%}