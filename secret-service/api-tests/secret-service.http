### =========================================================
### CapyVault Secret Service API Tests
### Base URL: http://localhost:8083
### Requires project-service running at http://localhost:8082
### =========================================================

@secretBaseUrl = http://localhost:8083
@actorUuid = 11111111-1111-1111-1111-111111111111
@projectUuid = 971a59d6-00e5-487d-8ae2-61ad3ca163d7
@prodEnvironmentUuid = a0725c6f-6b20-4d65-ba6e-d33993fac786

### ---------------------------------------------------------
### 1. Health check
### ---------------------------------------------------------
GET {{secretBaseUrl}}/actuator/health
Accept: application/json


### ---------------------------------------------------------
### 2. Create DATABASE_PASSWORD secret
### This calls project-service internally to validate project/environment.
### ---------------------------------------------------------
POST {{secretBaseUrl}}/api/v1/secrets
Content-Type: application/json
Accept: application/json

{
  "projectUuid": "{{projectUuid}}",
  "environmentUuid": "{{prodEnvironmentUuid}}",
  "key": "DATABASE_PASSWORD",
  "value": "postgres-password-123",
  "description": "Production database password",
  "actorUuid": "{{actorUuid}}"
}

> {%
    client.test("Create DATABASE_PASSWORD secret - success", function () {
        client.assert(response.status === 201 || response.status === 200, "Expected 201 or 200");
    });

    client.global.set("databasePasswordSecretUuid", response.body.data.uuid);

    client.log("Created secret UUID: " + response.body.data.uuid);
%}


### ---------------------------------------------------------
### 3. Create REDIS_PASSWORD secret
### ---------------------------------------------------------
POST {{secretBaseUrl}}/api/v1/secrets
Content-Type: application/json
Accept: application/json

{
  "projectUuid": "{{projectUuid}}",
  "environmentUuid": "{{prodEnvironmentUuid}}",
  "key": "REDIS_PASSWORD",
  "value": "redis-password-456",
  "description": "Production Redis password",
  "actorUuid": "{{actorUuid}}"
}

> {%
    client.test("Create REDIS_PASSWORD secret - success", function () {
        client.assert(response.status === 201 || response.status === 200, "Expected 201 or 200");
    });

    client.global.set("redisPasswordSecretUuid", response.body.data.uuid);

    client.log("Created Redis secret UUID: " + response.body.data.uuid);
%}


### ---------------------------------------------------------
### 4. List secrets by project and environment
### Should return metadata only, not real secret values.
### ---------------------------------------------------------
GET {{secretBaseUrl}}/api/v1/secrets?projectUuid={{projectUuid}}&environmentUuid={{prodEnvironmentUuid}}
Accept: application/json

> {%
    client.test("List secrets - success", function () {
        client.assert(response.status === 200, "Expected 200");
    });
%}


### ---------------------------------------------------------
### 5. Get secret metadata by UUID
### ---------------------------------------------------------
GET {{secretBaseUrl}}/api/v1/secrets/{{databasePasswordSecretUuid}}
Accept: application/json

> {%
    client.test("Get secret metadata - success", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.data.uuid === client.global.get("databasePasswordSecretUuid"), "Secret UUID should match");
    });
%}


### ---------------------------------------------------------
### 6. Read real secret value
### Sensitive operation.
### In production this should also write audit log.
### ---------------------------------------------------------
GET {{secretBaseUrl}}/api/v1/secrets/{{databasePasswordSecretUuid}}/value
Accept: application/json

> {%
    client.test("Read secret value - success", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.data.value === "postgres-password-123", "Secret value should match original value");
    });
%}


### ---------------------------------------------------------
### 7. Rotate secret value
### Creates new secret version.
### ---------------------------------------------------------
POST {{secretBaseUrl}}/api/v1/secrets/{{databasePasswordSecretUuid}}/versions
Content-Type: application/json
Accept: application/json

{
  "value": "postgres-password-rotated-789",
  "actorUuid": "{{actorUuid}}"
}

> {%
    client.test("Rotate secret - success", function () {
        client.assert(response.status === 201 || response.status === 200, "Expected 201 or 200");
    });
%}


### ---------------------------------------------------------
### 8. Read real secret value after rotation
### Should return the newest version.
### ---------------------------------------------------------
GET {{secretBaseUrl}}/api/v1/secrets/{{databasePasswordSecretUuid}}/value
Accept: application/json

> {%
    client.test("Read rotated secret value - success", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.data.value === "postgres-password-rotated-789", "Secret value should match rotated value");
    });
%}


### ---------------------------------------------------------
### 9. Get secret versions
### ---------------------------------------------------------
GET {{secretBaseUrl}}/api/v1/secrets/{{databasePasswordSecretUuid}}/versions
Accept: application/json

> {%
    client.test("Get secret versions - success", function () {
        client.assert(response.status === 200, "Expected 200");
    });
%}


### ---------------------------------------------------------
### 10. Update secret metadata
### Does not change secret value.
### ---------------------------------------------------------
PUT {{secretBaseUrl}}/api/v1/secrets/{{databasePasswordSecretUuid}}
Content-Type: application/json
Accept: application/json

{
  "description": "Updated production database password description"
}

> {%
    client.test("Update secret metadata - success", function () {
        client.assert(response.status === 200, "Expected 200");
    });
%}


### ---------------------------------------------------------
### 11. Duplicate secret key test
### Expected: 409 Conflict or 400 Bad Request
### ---------------------------------------------------------
POST {{secretBaseUrl}}/api/v1/secrets
Content-Type: application/json
Accept: application/json

{
  "projectUuid": "{{projectUuid}}",
  "environmentUuid": "{{prodEnvironmentUuid}}",
  "key": "DATABASE_PASSWORD",
  "value": "another-password",
  "description": "Duplicate secret key test",
  "actorUuid": "{{actorUuid}}"
}

> {%
    client.test("Duplicate secret key should fail", function () {
        client.assert(
            response.status === 409 || response.status === 400,
            "Expected 409 or 400"
        );
    });
%}


### ---------------------------------------------------------
### 12. Invalid project/environment validation test
### Expected: 404, 400, or 500 depending on your current exception mapping
### ---------------------------------------------------------
POST {{secretBaseUrl}}/api/v1/secrets
Content-Type: application/json
Accept: application/json

{
  "projectUuid": "99999999-9999-9999-9999-999999999999",
  "environmentUuid": "88888888-8888-8888-8888-888888888888",
  "key": "INVALID_PROJECT_SECRET",
  "value": "should-not-save",
  "description": "This should fail because project/environment does not exist",
  "actorUuid": "{{actorUuid}}"
}

> {%
    client.test("Invalid project/environment should fail", function () {
        client.assert(
            response.status >= 400,
            "Expected error response"
        );
    });
%}


### ---------------------------------------------------------
### 13. Delete secret
### Soft delete or disable depending on your implementation.
### ---------------------------------------------------------
DELETE {{secretBaseUrl}}/api/v1/secrets/{{redisPasswordSecretUuid}}
Accept: application/json

> {%
    client.test("Delete Redis secret - success", function () {
        client.assert(response.status === 200 || response.status === 204, "Expected 200 or 204");
    });
%}