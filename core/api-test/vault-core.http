@secretId = 2dab4ed0-4e04-46e5-83b1-d9776ea246bf


### Create secret
POST http://localhost:8083/api/v1/secrets
Content-Type: application/json

{
  "projectId": "11111111-1111-1111-1111-111111111111",
  "environmentId": "22222222-2222-2222-2222-222222222222",
  "name": "DATABASE_PASSWORD",
  "type": "PASSWORD",
  "value": "my-first-password"
}


### Get secret metadata
GET http://localhost:8083/api/v1/secrets/{{secretId}}


### Get secret value
GET http://localhost:8083/api/v1/secrets/{{secretId}}/value


### Update secret value - creates version 2
PUT http://localhost:8083/api/v1/secrets/{{secretId}}/value
Content-Type: application/json

{
  "value": "my-second-password"
}


### Create rotation policy
POST http://localhost:8083/api/v1/rotation-policies
Content-Type: application/json

{
  "secretId": "{{secretId}}",
  "intervalDays": 30,
  "strategy": "MANUAL_VALUE"
}


### Execute manual rotation - creates version 3
POST http://localhost:8083/api/v1/rotation-policies/secrets/{{secretId}}/execute?value=my-rotated-password


### Delete secret
DELETE http://localhost:8083/api/v1/secrets/{{secretId}}